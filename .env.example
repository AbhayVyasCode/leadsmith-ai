# Copy this file to ".env" and fill in the three keys.

# ---- Chat / reasoning model: ANY OpenRouter model (free or paid) ----
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_key_here
# Pick any model. Free examples:
#   nvidia/nemotron-3-super-120b-a12b:free
#   deepseek/deepseek-chat-v3-0324:free
#   moonshotai/kimi-k2:free
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Web search: Tavily (free tier ~1,000 searches/month) ----
# Get a free key at https://app.tavily.com
TAVILY_API_KEY=your_key_here

# ---- Embeddings: Google Gemini (free tier) ----
# Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
# Current Gemini embedding model (3072-dim). Alternative: gemini-embedding-2
EMBEDDING_MODEL=gemini-embedding-001

# Free-tier rate control. OpenRouter free models allow ~15-20 requests/min.
RPM_LIMIT=20
MAX_CONCURRENCY=4

# Where the cache + vector memory live.
DATA_DIR=.leadsmith_data

# Optional: Hunter.io free-tier key for verified-email top-ups (leave blank to skip).
HUNTER_API_KEY=
